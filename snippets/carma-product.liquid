<div class="carma-product-card d-flex flex-column justify-content-between">
  <a href="{{ product.url }}" class="text-decoration-none text-black">
    <!-- Imagen principal del producto -->
    <div class="carma-product-card__image">
      <img
        src="{{ product.featured_image | image_url }}"
        alt="{{ product.title }}"
        width="100%"
        height="auto"
        class="rounded-4"
      >
    </div>

    <!-- Etiqueta del producto (primera etiqueta) -->
    {% if product.vendor %}
      <div class="carma-product-card__label mt-5">
        {{ product.vendor }}
      </div>
    {% endif %}

    <!-- Título del producto -->
    <div class="carma-product-card__title my-2">
      {{ product.title }}
    </div>

    <!-- Precio del producto -->
    <div class="carma-product-card__price mb-4">
      {% if product.compare_at_price > product.price %}
        <span class="carma-product-card__price--sale fw-bold">
          {{ product.price | money }}
        </span>
        <span class="carma-product-card__price--compare text-muted text-decoration-line-through ms-2">
          {{ product.compare_at_price | money }}
        </span>
      {% else %}
        <span class="carma-product-card__price--regular">
          {{ product.price | money }}
        </span>
      {% endif %}
    </div>
  </a>

  <!-- Botón de añadir al carrito -->
  <form method="post" action="{{ routes.cart_add_url }}">
    <input type="hidden" name="id" value="{{ product.variants.first.id }}">
    <button
      type="submit"
      class="button-add-to-cart w-100"
    >
      Añadir al carrito
    </button>
  </form>
</div>
