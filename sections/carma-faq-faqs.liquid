{% schema %}
{
  "name": "Preguntas frecuentes",
  "settings": [
    {
      "type": "text",
      "id": "title1",
      "label": "Sección 1",
      "default": "Envíos y devoluciones"
    },
    {
      "type": "text",
      "id": "title2",
      "label": "Sección 2",
      "default": "Productos"
    },
    {
      "type": "text",
      "id": "title3",
      "label": "Sección 3",
      "default": "Sucursales"
    }
  ],
  "blocks": [
    {
      "type": "seccion1",
      "name": "Sección 1",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Pregunta"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Respuesta"
        }
      ]
    },
    {
      "type": "seccion2",
      "name": "Sección 2",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Pregunta"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Respuesta"
        }
      ]
    },
    {
      "type": "seccion3",
      "name": "Sección 3",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Pregunta"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Respuesta"
        }
      ]
    }
  ]
}
{% endschema %}
<section class="carma-faq my-md-5 py-md-5">
  <div class="container my-5 py-5">
    <div class="row gy-5">
      <div class="nav flex-md-column col-md-3" id="v-pills-tab" role="tablist" aria-orientation="vertical">
        {% for i in (1..3) %}
          {% capture setting_name %}title{{ i }}{% endcapture %}
          <p
            class="nav-link{% if forloop.first %} active{% endif %}"
            id="v-pills-{{ i }}-tab"
            data-bs-toggle="pill"
            data-bs-target="#v-pills-{{ i }}"
            type="button"
            role="tab"
            aria-controls="v-pills-{{ i }}"
            aria-selected="{{ forloop.first | default: 'true' }}"
          >
            {{ section.settings[setting_name] }}
          </p>
        {% endfor %}
      </div>
      <div class="tab-content col-md-9" id="v-pills-tabContent">
        {% for i in (1..3) %}
          {% capture setting_name %}title{{ i }}{% endcapture %}
          <div
            class="tab-pane fade{% if forloop.first %}show active{% endif %}"
            id="v-pills-{{ i }}"
            role="tabpanel"
            aria-labelledby="v-pills-{{ i }}-tab"
            tabindex="0"
          >
            {% capture section_name %}seccion{{ i }}{% endcapture %}
            <h2 class="mb-md-5 mb-0 pb-3">{{ section.settings[setting_name] }}</h2>
            <div class="carma-servicio-faq">
              <div class="accordion" id="accordion-{{ i }}">
                {% for block in section.blocks %}
                  {% if block.type == section_name %}
                    <div class="accordion-item">
                      <h2 class="accordion-header">
                        <button
                          class="accordion-button fw-medium{% unless forloop.first %} collapsed{% endunless %}"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#collapse-{{ forloop.index }}"
                          aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                          aria-controls="collapse-{{ forloop.index }}"
                        >
                          {{ block.settings.title }}
                        </button>
                      </h2>
                      <div
                        id="collapse-{{ forloop.index }}"
                        class="accordion-collapse collapse{% if forloop.first %} show{% endif %}"
                        data-bs-parent="#accordion-{{ i }}"
                      >
                        <div class="accordion-body">
                          {{ block.settings.text }}
                        </div>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
