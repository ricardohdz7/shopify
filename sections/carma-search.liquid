{% schema %}
{
  "name": "Productos",
  "settings": [
    {
      "type": "range",
      "id": "pagesize",
      "label": "Cantidad de productos por página",
      "step": 3,
      "min": 3,
      "max": 24,
      "default": 12,
      "unit": "uds"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Seleccionar menú lateral"
    }
  ]
}
{% endschema %}

{% comment %}
  Carma – plantilla de BÚSQUEDA con filtros laterales
  (Replica 1:1 de la estructura de colección, adaptada a search)
  Requiere:
  - snippet 'carma-product'
  - facets.js (Dawn)
{% endcomment %}

<section class="carma-main-search my-5 py-5">
  <div class="container">
    <h3 class="text-center mb-5">Búsqueda</h3>
    <div class="row justify-content-center">
      <div class="col-lg-7">
        <form class="d-flex" role="search" action="/search" method="get">
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">
          <input type="hidden" name="options[unavailable_products]" value="show">
          <div class="input-group input-group-lg">
            <input
              type="search"
              class="form-control"
              placeholder="Buscar aqui"
              aria-label="Buscar aqui"
              aria-describedby="button-addon2"
              name="q"
              value="{{ search.terms | escape }}"
            >
            <button class="btn btn-outline-secondary" type="submit" id="button-addon2">
              <img src="{{ '4183.svg' | asset_url }}" width="100%" height="auto">
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

{%- comment -%} Dawn core assets – NUEVO/ACTUALIZADO {%- endcomment -%}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | preload_tag: as: 'style' }}

<section class="carma-collection-main py-5">
  <div class="container my-4">
    {%- paginate search.results by section.settings.pagesize -%}
      <!-- Encabezado con total de resultados y sort-by -->
      <div class="row justify-content-end mb-5 d-none d-md-flex">
        <div class="col-lg-9">
          <div class="row align-items-center">
            <div class="col">
              <p class="m-0" id="ProductCount" aria-live="polite">{{ paginate.items }} productos</p>
            </div>
            <div class="col-auto">
              <facet-filters-form class="facet-form facets" data-section-id="{{ section.id }}">
                <form id="FacetSortFormDesktop" class="facets__form" method="get">
                  <!-- Mantener el contexto de búsqueda -->
                  <input type="hidden" name="q" value="{{ search.terms | escape }}">
                  <input type="hidden" name="type" value="product">
                  <input type="hidden" name="options[prefix]" value="last">
                  <input type="hidden" name="options[unavailable_products]" value="show">

                  <div class="facet-sort d-flex align-items-center">
                    <label for="SortByDesktop" class="form-label fw-bold me-2 mb-0">Ordenar por:</label>
                    {%- assign current_sort = search.sort_by -%}
                    <select
                      name="sort_by"
                      id="SortByDesktop"
                      class="form-select form-select-sm w-auto form-control"
                    >
                      {% for option in search.sort_options %}
                        <option
                          value="{{ option.value }}"
                          {% if option.value == current_sort %}
                            selected
                          {% endif %}
                        >
                          {{ option.name }}
                        </option>
                      {% endfor %}
                    </select>
                  </div>

                  <noscript>
                    <button type="submit" class="btn btn-secondary btn-sm mt-2">Aplicar</button>
                  </noscript>
                </form>
              </facet-filters-form>
            </div>
          </div>
        </div>
      </div>

      <section class="contenedor-filtro-y-resultados-movil d-md-none">
        <div class="row justify-content-between mb-5 align-items-center">
          <div class="col-auto">
            <div
              class="btn-filtro d-flex align-items-center column-gap-2 px-4 py-3 rounded-pill"
              data-bs-toggle="offcanvas"
              data-bs-target="#offcanvasBottom"
              aria-controls="offcanvasBottom"
            >
              <p class="m-0">Filtro</p>
              <img width="auto" height="auto" src="{{ '5742.svg' | asset_url}}">
            </div>
          </div>
          <div class="col-auto">
            <p class="m-0 result-count" id="ProductCountMobile" aria-live="polite">{{ paginate.items }} productos</p>
          </div>
        </div>
      </section>

      <div
        class="offcanvas offcanvas-bottom"
        tabindex="-1"
        id="offcanvasBottom"
        aria-labelledby="offcanvasBottomLabel"
      >
        <div class="offcanvas-header">
          <h3 id="offcanvasBottomLabel">Filtro</h3>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
          ></button>
        </div>
        <div class="offcanvas-body">
          <facet-filters-form class="facet-form facets" data-section-id="{{ section.id }}">
            <form id="FacetSortFormMobile" class="facets__form" method="get">
              <!-- Mantener el contexto de búsqueda -->
              <input type="hidden" name="q" value="{{ search.terms | escape }}">
              <input type="hidden" name="type" value="product">
              <input type="hidden" name="options[prefix]" value="last">
              <input type="hidden" name="options[unavailable_products]" value="show">

              {%- assign current_sort = search.sort_by -%}
              <div class="facet-sort sort px-4">
                <p class="my-4 fw-bold">Ordenar</p>

                <div class="" role="radiogroup" aria-label="Ordenar por">
                  {% for option in search.sort_options %}
                    {%- assign radio_id = 'sort-mobile-' | append: section.id | append: '-' | append: forloop.index -%}
                    <label class="list-group-item d-flex align-items-center gap-3 mt-3" for="{{ radio_id }}">
                      <input
                        class="form-check-input m-0"
                        type="radio"
                        name="sort_by_radio"
                        id="{{ radio_id }}"
                        value="{{ option.value }}"
                        {% if option.value == current_sort %}
                          checked
                        {% endif %}
                      >
                      <span class="flex-grow-1">{{ option.name }}</span>
                    </label>
                  {% endfor %}
                </div>
              </div>

              <noscript>
                <button type="submit" class="btn btn-secondary btn-sm mt-3">Aplicar</button>
              </noscript>
            </form>
          </facet-filters-form>

          {% render 'carma-filters',
            filters: search.filters,
            section_id: section.id,
            mode: 'search',
            search_terms: search.terms
          %}
        </div>
        <div class="offcanvas-footer">
          <button class="btn btn-dark w-100 btn-lg py-3" data-bs-dismiss="offcanvas" id="OffcanvasResultsBtn">
            Ver resultados ({{ paginate.items }})
          </button>
          <p class="text-decoration-underline text-white text-center mt-4">Limpiar todo</p>
        </div>
      </div>

      <div class="overflow-hidden">
        <div class="row justify-content-between g-5">
          <!-- Sidebar filtros -->
          <aside class="col-12 col-md-4 col-lg-3 d-none d-md-block">
            {% render 'carma-filters',
              filters: search.filters,
              section_id: section.id,
              mode: 'search',
              search_terms: search.terms
            %}
          </aside>

          <!-- Grid productos -->
          <div class="col-12 col-md-8 col-lg-9 overflow-hidden">
            <!-- Dawn expects this wrapper to exist at all times -->
            <div id="ProductGridContainer">
              {% if search.results.size == 0 %}
                <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
                  <div class="loading-overlay gradient"></div>
                  <p class="py-4 m-0">No hay productos que coincidan con los filtros.</p>
                </div>
              {% else %}
                <div
                  id="product-grid"
                  data-id="{{ section.id }}"
                  class="collection"
                >
                  <div class="loading-overlay gradient"></div>

                  <div class="row gx-4 custom-gy">
                    {% for item in search.results %}
                      {% if item.object_type == 'product' %}
                        <div class="col-6 col-lg-4">
                          {% render 'carma-product', product: item %}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            </div>
            <!-- /#ProductGridContainer -->

            {% render 'carma-pagination', paginate: paginate %}
          </div>
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</section>

<!-- Facets mobile drawer (needed by facets.js) -->
<menu-drawer class="mobile-facets d-none">
  <facet-filters-form class="facet-form facets" data-section-id="{{ section.id }}">
    <form id="FacetFiltersFormMobile" class="facets__form" method="get">
      <!-- Mantener el contexto de búsqueda para evitar comportamientos raros en JS -->
      <input type="hidden" name="q" value="{{ search.terms | escape }}">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      <input type="hidden" name="options[unavailable_products]" value="show">
      <!--
        Se pueden renderizar filtros móviles aquí,
        pero basta el placeholder para evitar errores JS
      -->
    </form>
  </facet-filters-form>
</menu-drawer>

{% comment %}
  Carga los scripts nativos de Dawn que gestionan filtros y orden via AJAX.
  Se insertan aquí para que esta plantilla funcione incluso si el layout
  principal no los incluye.
{% endcomment %}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script>
  (function () {
    var clearBtn = document.querySelector('.offcanvas-footer p');
    if (!clearBtn) return;

    clearBtn.addEventListener('click', function () {
      // Limpia filtros/sort pero mantiene el término de búsqueda y parámetros base.
      var q = '{{ search.terms | escape }}';
      var base = new URLSearchParams();
      if (q) base.set('q', q);
      base.set('type', 'product');
      base.set('options[prefix]', 'last');
      base.set('options[unavailable_products]', 'show');
      window.location.href = '/search?' + base.toString();
    });
  })();
</script>
