{% schema %}
{
  "name": "Compra por actividad",
  "presets": [
    {
      "name": "Compra por actividad"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Compra por actividad"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Texto del botón",
      "default": "Comprar"
    }
  ],
  "blocks": [
    {
      "type": "actividad",
      "name": "Actividad",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nombre de actividad"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imágen"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Enlace"
        }
      ]
    }
  ]
}
{% endschema %}
<div class="carma-actividad py-5">
  <div class="container my-sm-5 py-5">
    <h1 class="mb-5">{{- section.settings.title -}}</h1>
    <div class="row gy-4">
      {% for block in section.blocks %}
        <div class="col-sm-6{% if forloop.index > 2 %} col-md-4{% endif %}">
          <div
            class="actividad rounded position-relative"
            style="background-image:url('{{ block.settings.image | image_url }}')"
          >
            <div class="content p-5">
              <h3 class="text-white mb-4">{{ block.settings.title }}</h3>
              <a href="{{ block.settings.url }}" class="boton white">{{ section.settings.button }}</a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
