{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imágen de fondo"
    }
  ]
}
{% endschema %}
<div
  class="carma-faq-header pt-5 position-relative d-flex align-items-end"
  style="background-image:url('{{ section.settings.image | image_url }}')"
>
  <div class="container mt-5 py-5 position-relative z-2">
    <h1 class="text-white mt-5 pt-5">{{ page.title }}</h1>
  </div>
</div>
