{% schema %}
{
  "name": "Listado de productos",
  "presets": [
    {
      "name": "Listado de productos"
    }
  ],
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Seleccionar colección"
    },
    {
      "type": "number",
      "id": "quantity",
      "label": "Cantidad de productos a mostrar",
      "default": 8
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texto del botón",
      "default": "Ver todos"
    }
  ]
}
{% endschema %}
<section class="list-of-products py-5">
  <div class="py-5 my-5 container">
    <div class="row align-items-end mb-5 pb-3">
      <div class="col">
        <h1 class="fw-semibold m-0">{{ section.settings.collection.title }}</h1>
      </div>
      <div class="col-auto">
        <a
          href="{{ section.settings.collection.url }}"
          class="d-flex align-items-center column-gap-2 text-decoration-none view-all"
        >
          <p class="m-0">{{ section.settings.text }}</p>
          <img width="auto" height="auto" src="{{ '4199.svg' | asset_url }}" class="icon">
        </a>
      </div>
    </div>
    <div class="row custom-gy">
      {% for product in collections[section.settings.collection].products limit: section.settings.quantity %}
        <div class="col-6 col-md-4 col-lg-3">
          {% render 'carma-product', product: product %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
