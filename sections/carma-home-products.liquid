{% schema %}
{
  "name": "Listado de productos",
  "presets": [
    {
      "name": "Listado de productos"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título de la sección",
      "default": "Nuestros Productos"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Seleccionar colección (Opcional)"
    },
    {
      "type": "number",
      "id": "quantity",
      "label": "Cantidad de productos a mostrar",
      "default": 12
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texto del botón",
      "default": "Ver todo el catálogo"
    }
  ]
}
{% endschema %}

<section class="list-of-products py-5 bg-light">
  <div class="container py-4">
    {% assign selected_coll = collections[section.settings.collection] %}
    {% if selected_coll != blank and selected_coll.products_count > 0 %}
      {% assign product_list = selected_coll.products %}
      {% assign section_title = selected_coll.title %}
    {% else %}
      {% assign product_list = collections.all.products %}
      {% assign section_title = section.settings.title | default: "Nuestros Productos" %}
    {% endif %}

    <div class="row align-items-center justify-content-between mb-4 pb-2">
      <div class="col">
        <h2 class="fw-bold m-0 display-6 text-dark">{{ section_title }}</h2>
        <p class="text-muted m-0 mt-1">Descubre nuestros productos disponibles</p>
      </div>
      <div class="col-auto">
        <a
          href="/collections/all"
          class="btn btn-outline-dark fw-semibold px-4 py-2 rounded-pill"
        >
          {{ section.settings.text | default: "Ver todo el catálogo" }} &rarr;
        </a>
      </div>
    </div>

    <div class="row g-4">
      {% assign total_items = 0 %}
      {% for product in product_list limit: section.settings.quantity %}
        {% assign total_items = total_items | plus: 1 %}
        <div class="col-6 col-md-4 col-lg-3">
          {% render 'carma-product', product: product %}
        </div>
      {% endfor %}

      {% if total_items == 0 %}
        {% comment %} Mostrar la colección global de la tienda si product_list vino vacia {% endcomment %}
        {% for product in collections['all'].products limit: section.settings.quantity %}
          {% assign total_items = total_items | plus: 1 %}
          <div class="col-6 col-md-4 col-lg-3">
            {% render 'carma-product', product: product %}
          </div>
        {% endfor %}
      {% endif %}

      {% if total_items == 0 %}
        <div class="col-12 text-center py-5">
          <p class="fs-4 text-muted mb-3">Aún no se han publicado productos activos en la tienda.</p>
          <p class="small text-muted">Asegúrate de que tus productos en el administrador estén configurados como <strong>Activo</strong> y asignados al canal de ventas <strong>Tienda online</strong>.</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>
