{% schema %}
{
  "name": "Categorías",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Explorar categorías"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Texto del botón",
      "default": "Comprar"
    }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoría",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nombre de la categoría"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        }
      ]
    }
  ]
}
{% endschema %}
<div class="carma-actividad py-5">
  <div class="container my-sm-5 py-5">
    <h1 class="mb-5">{{- section.settings.title -}}</h1>
    <div class="row gy-4">
      {% for block in section.blocks %}
        <div class="col-sm-6 col-md-4">
          <div
            class="actividad rounded position-relative"
            style="{% if block.settings.collection and block.settings.collection.image %}background-image:url('{{ block.settings.collection.image | image_url }}'){% endif %}"
          >
            <div class="content p-5">
              <h3 class="text-white mb-4">{{ block.settings.title | default: block.settings.collection.title }}</h3>
              <a href="{{ block.settings.collection.url | default: '#' }}" class="boton white">
                {{- section.settings.button -}}
              </a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
