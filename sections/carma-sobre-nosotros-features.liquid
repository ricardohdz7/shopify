{% schema %}
{
  "name": "Features",
  "blocks": [
    {
      "type": "features",
      "name": "Features",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Añadir texto"
        }
      ]
    }
  ]
}
{% endschema %}
<section class="carma-sobre-nosotros-innovacion-features marquee py-4">
  {% for block in section.blocks %}
    <div>
      <h3 class="mb-0 text-white">{{- block.settings.title -}}</h3>
    </div>
    <div class="mx-5"><h3 class="mb-0 aqua">٭</h3></div>
  {% endfor %}
</section>
