{% schema %}
{
  "name": "Baner destacado",
  "presets": [
    {
      "name": "Baner destacado"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imágen para escritorio"
    },
    {
      "type": "image_picker",
      "id": "imagemovil",
      "label": "Imágen para móvil"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Enlace"
    }
  ]
}
{% endschema %}
{% liquid
  assign desktop_src = section.settings.image | image_url
  if desktop_src contains 'no-image' or desktop_src == blank
    assign fn = section.settings.image | split: '/' | last
    if fn != blank
      assign desktop_src = 'https://casamunozmedipedi.com/cdn/shop/files/' | append: fn
    endif
  endif

  assign movil_src = section.settings.imagemovil | image_url
  if movil_src contains 'no-image' or movil_src == blank
    assign fn_m = section.settings.imagemovil | split: '/' | last
    if fn_m != blank
      assign movil_src = 'https://casamunozmedipedi.com/cdn/shop/files/' | append: fn_m
    endif
  endif
%}
<a href="{{- section.settings.url | default: '#' -}}">
  <picture>
    {%- if movil_src != blank -%}
      <source
        media="(max-width: 767px)"
        srcset="{{ movil_src }}"
      >
    {%- endif -%}
    {%- if desktop_src != blank -%}
      <img
        src="{{ desktop_src }}"
        alt=""
        class="img-fluid w-100"
        loading="lazy"
        width="100%"
        height="auto"
      >
    {%- endif -%}
  </picture>
</a>
