{% schema %}
{
  "name": "Baner",
  "presets": [
    {
      "name": "Baner"
    }
  ],
  "blocks": [
    {
      "type": "baner",
      "name": "Baner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Seleccionar imagen para escritorio"
        },
        {
          "type": "image_picker",
          "id": "movil",
          "label": "Seleccionar imagen para móviles"
        },
        {
          "type": "url",
          "id": "enlace",
          "label": "Enlace"
        }
      ]
    }
  ]
}
{% endschema %}
<div class="swiper baner">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      {% liquid
        assign desktop_src = block.settings.image | image_url
        if desktop_src contains 'no-image' or desktop_src == blank
          assign fn = block.settings.image | split: '/' | last
          if fn != blank
            assign desktop_src = 'https://casamunozmedipedi.com/cdn/shop/files/' | append: fn
          endif
        endif

        assign movil_src = block.settings.movil | image_url
        if movil_src contains 'no-image' or movil_src == blank
          assign fn_m = block.settings.movil | split: '/' | last
          if fn_m != blank
            assign movil_src = 'https://casamunozmedipedi.com/cdn/shop/files/' | append: fn_m
          endif
        endif
      %}
      <div class="swiper-slide" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.enlace | default: '#' }}">
          <picture>
            {% if movil_src != blank %}
              <source media="(max-width: 767px)" srcset="{{ movil_src }}">
            {% endif %}
            {% if desktop_src != blank %}
              <img
                src="{{ desktop_src }}"
                alt=""
                class="img-fluid w-100"
                loading="lazy"
                width="100%"
                height="auto"
              >
            {% elsif movil_src != blank %}
              <img
                src="{{ movil_src }}"
                alt=""
                class="img-fluid w-100"
                loading="lazy"
                width="100%"
                height="auto"
              >
            {% endif %}
          </picture>
        </a>
      </div>
    {% endfor %}
  </div>
  <div class="swiper-button-next"></div>
  <div class="swiper-button-prev"></div>
</div>
